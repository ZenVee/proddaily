# Prod Daily — Supabase (browser-safe)
# Copy to .env and fill from your Supabase project Settings → API Keys
# Use the publishable key (not the secret / service_role key).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Never put the secret/service_role key or Discord client secret in VITE_* vars.
# Those belong only in Supabase Dashboard / Edge Function secrets.
